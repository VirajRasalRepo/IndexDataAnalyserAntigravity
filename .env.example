# ============================================================
# Index Data Analyser - Environment Configuration
# Copy this file to .env and update with your values
# ============================================================

# Dhan API Configuration
# Get these from: https://dhanhq.co/developer
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=analyzer_db
DB_PORT=3306

# Application Settings
TRADE_SYNC_INTERVAL=60          # Seconds between trade syncs
DATA_FETCH_INTERVAL=4           # Seconds between data fetches
STRIKE_RANGE=750                # Strike price range
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
DEBUG=False                     # True for development, False for production

# Market Hours (IST) - Don't change these unless market hours change
MARKET_START_HOUR=9
MARKET_START_MINUTE=15
MARKET_END_HOUR=15
MARKET_END_MINUTE=30
