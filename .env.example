# ============================================================
# Index Data Analyser - Environment Configuration
# Copy this file to .env and update with your values
#   cp .env.example .env
# ============================================================

# Dhan API Configuration
# Get these from: https://dhanhq.co/developer
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=analyzer_db
DB_PORT=3306

# Application Settings
TRADE_SYNC_INTERVAL=60          # Seconds between trade syncs
DATA_FETCH_INTERVAL=4           # Seconds between option chain fetches
STRIKE_RANGE=750                # Strike price range around ATM
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
DEBUG=False                     # True for development, False for production

# Market Hours (IST) - Don't change unless NSE changes trading hours
MARKET_START_HOUR=9
MARKET_START_MINUTE=15
MARKET_END_HOUR=15
MARKET_END_MINUTE=30

# Gunicorn Settings (production only, used by start.sh)
# GUNICORN_WORKERS=4            # Number of worker processes (default: 4)
# GUNICORN_TIMEOUT=120          # Request timeout in seconds (default: 120)
# GUNICORN_BIND=0.0.0.0:5000   # Bind address:port (default: 0.0.0.0:5000)

# VM Sync Configuration (used by sync_from_vm.py)
# Credentials for the MySQL instance running on the GCP VM.
VM_DB_USER=root
VM_DB_PASSWORD=your_vm_db_password
VM_DB_NAME=analyzer_db
GCP_PROJECT=your_gcp_project_id
# Optional: override path to local mysql.exe on Windows
# MYSQL_BIN=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
