<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Greeks Dashboard - OI Analytics</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #0d1117;
            color: #c9d1d9;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: #0f1420;
            border-right: 1px solid #0f172a;
            padding: 24px 0;
            display: flex;
            flex-direction: column;
        }

        .logo {
            padding: 0 24px 24px 24px;
            font-size: 18px;
            font-weight: 600;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-menu {
            flex: 1;
            padding: 0 12px;
        }

        .nav-item {
            padding: 12px 12px;
            margin: 4px 0;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 14px;
            color: #8b949e;
        }

        .nav-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: #c9d1d9;
        }

        .nav-item.active {
            background: #1f6feb;
            color: #fff;
        }

        /* Main Content */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .header {
            background: #0d1117;
            border-bottom: 1px solid #0f172a;
            padding: 16px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-title {
            font-size: 20px;
            font-weight: 600;
            color: #fff;
        }

        .header-info {
            display: flex;
            gap: 24px;
            align-items: center;
            font-size: 13px;
            color: #8b949e;
        }

        .live-dot {
            width: 8px;
            height: 8px;
            background: #3fb950;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .content-area {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
        }

        /* Metric Cards */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .metric-card {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 12px;
            padding: 20px;
        }

        .metric-label {
            font-size: 12px;
            color: #8b949e;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .metric-value {
            font-size: 28px;
            font-weight: 700;
            color: #fff;
            line-height: 1.2;
        }

        .metric-change {
            font-size: 13px;
            margin-top: 6px;
            font-weight: 500;
        }

        .positive { color: #3fb950; }
        .negative { color: #f85149; }
        .neutral { color: #d29922; }

        /* Alert Banner */
        .alert-banner {
            background: linear-gradient(90deg, #d29922 0%, #e3b341 100%);
            color: #1c1917;
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 24px;
            font-weight: 500;
            font-size: 13px;
        }

        /* Main Grid Layout */
        .grid-layout {
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 24px;
            margin-bottom: 24px;
        }

        /* Tables and Panels */
        .panel {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 12px;
            overflow: hidden;
        }

        .panel-header {
            padding: 16px 20px;
            border-bottom: 1px solid #30363d;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .panel-title {
            font-size: 15px;
            font-weight: 600;
            color: #fff;
        }

        .panel-subtitle {
            font-size: 12px;
            color: #8b949e;
        }

        .panel-body {
            padding: 0;
        }

        /* Table Styles */
        .table-container {
            overflow-x: auto;
            max-height: 600px;
            overflow-y: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #0d1117;
            padding: 12px 16px;
            text-align: left;
            font-size: 11px;
            font-weight: 600;
            color: #8b949e;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        td {
            padding: 14px 16px;
            border-top: 1px solid #21262d;
            font-size: 13px;
        }

        tbody tr:hover {
            background: rgba(255, 255, 255, 0.03);
        }

        /* Badges */
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .badge-atm { background: #1f6feb; color: #fff; }
        .badge-itm { background: #238636; color: #fff; }
        .badge-otm { background: #d29922; color: #1c1917; }
        .badge-scalp { background: #8250df; color: #fff; }
        .badge-deep_itm { background: #0969da; color: #fff; }

        /* Signal Badges */
        .signal-badge {
            padding: 6px 14px;
            border-radius: 16px;
            font-weight: 600;
            font-size: 11px;
            text-transform: uppercase;
        }

        .signal-entry { background: #238636; color: #fff; }
        .signal-exit { background: #da3633; color: #fff; }
        .signal-caution { background: #d29922; color: #1c1917; }
        .signal-gamma { background: #8250df; color: #fff; }

        /* Side Panels */
        .side-panels {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .chart-placeholder {
            height: 120px;
            background: linear-gradient(to top, rgba(31, 111, 235, 0.1), transparent);
            border-radius: 8px;
            margin: 12px;
            position: relative;
        }

        .alert-item {
            padding: 12px 20px;
            border-bottom: 1px solid #21262d;
            font-size: 13px;
        }

        .alert-item:last-child {
            border-bottom: none;
        }

        .alert-type {
            font-weight: 600;
            color: #f85149;
            font-size: 11px;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        /* Footer */
        .footer {
            background: #0f1420;
            border-top: 1px solid #0f172a;
            padding: 12px 24px;
            text-align: center;
            font-size: 12px;
            color: #8b949e;
        }

        /* Responsive */
        @media (max-width: 1400px) {
            .grid-layout {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .sidebar {
                display: none;
            }

            .metrics-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Loading State */
        .loading {
            text-align: center;
            padding: 60px 20px;
        }

        .error {
            background: #da3633;
            color: #fff;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            margin: 20px;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="logo">
            <span>📊</span> OI Analytics
        </div>
        <div class="nav-menu">
            <div class="nav-item" onclick="location.href='index.html'">📈 Dashboard</div>
            <div class="nav-item" onclick="location.href='historical_data.html'">📅 Historical Data</div>
            <div class="nav-item active">🎯 Greeks Monitor</div>
            <div class="nav-item" onclick="location.href='option_chain.html'">📊 Option Chain</div>
            <div class="nav-item" onclick="location.href='api_credentials.html'">⚙️ API Settings</div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Header -->
        <div class="header">
            <div class="header-title">Greeks Dashboard</div>
            <div class="header-info">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <div class="live-dot"></div>
                    <span>Live</span>
                </div>
                <span id="lastUpdate">Loading...</span>
                <span id="expiryInfo">Expiry: --</span>
            </div>
        </div>

        <!-- Content Area -->
        <div class="content-area">
            <!-- Metrics Grid -->
            <div class="metrics-grid">
                <div class="metric-card">
                    <div class="metric-label">NIFTY SPOT</div>
                    <div class="metric-value" id="spotPrice">--</div>
                    <div class="metric-change" id="spotChange">--</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">INDIA VIX</div>
                    <div class="metric-value" id="vixValue">--</div>
                    <div class="metric-change" id="vixChange">--</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">NET Δ FLOW</div>
                    <div class="metric-value" id="netDeltaFlow">--</div>
                    <div class="metric-change" id="marketBias">--</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">IV RANK</div>
                    <div class="metric-value" id="ivRank">--</div>
                    <div class="metric-change">52-Week Rank</div>
                </div>
            </div>

            <!-- Alert Banner -->
            <div class="alert-banner" id="alertBanner" style="display: none;">
                <span id="alertBannerText"></span>
            </div>

            <!-- Main Grid Layout -->
            <div class="grid-layout">
                <!-- Greeks Monitor Table -->
                <div class="panel">
                    <div class="panel-header">
                        <div>
                            <div class="panel-title">Greeks Monitor — Live Feed</div>
                            <div class="panel-subtitle">Top efficiency strikes (CE & PE)</div>
                        </div>
                    </div>
                    <div class="panel-body">
                        <div class="table-container">
                            <table id="greeksTable">
                                <thead>
                                    <tr>
                                        <th>Strike</th>
                                        <th>Type</th>
                                        <th>Rank</th>
                                        <th>LTP</th>
                                        <th>Efficiency</th>
                                        <th>Delta</th>
                                        <th>Theta</th>
                                        <th>Gamma</th>
                                        <th>IV</th>
                                        <th>Alerts</th>
                                    </tr>
                                </thead>
                                <tbody id="greeksTableBody">
                                    <tr><td colspan="10" style="text-align: center; padding: 40px;">Loading data...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Side Panels -->
                <div class="side-panels">
                    <!-- Daily Snapshot & Trends -->
                    <div class="panel">
                        <div class="panel-header">
                            <div class="panel-title">Daily Snapshot & Trends</div>
                        </div>
                        <div class="panel-body">
                            <div class="chart-placeholder" id="trendChart"></div>
                            <div style="padding: 12px 20px;">
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; font-size: 12px;">
                                    <div>
                                        <div style="color: #8b949e;">DTE</div>
                                        <div style="color: #fff; font-weight: 600; font-size: 18px;" id="dteValue">--</div>
                                    </div>
                                    <div>
                                        <div style="color: #8b949e;">PCR</div>
                                        <div style="color: #fff; font-weight: 600; font-size: 18px;" id="pcrValue">--</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Live Alerts -->
                    <div class="panel" id="alertsPanel" style="display: none;">
                        <div class="panel-header">
                            <div class="panel-title">Live Alerts</div>
                        </div>
                        <div class="panel-body" id="alertsContainer"></div>
                    </div>

                    <!-- Lotto Tracker -->
                    <div class="panel" id="lottoPanel" style="display: none;">
                        <div class="panel-header">
                            <div class="panel-title">Lotto Tracker</div>
                            <span class="badge badge-scalp">GAMMA BLAST</span>
                        </div>
                        <div class="panel-body" id="lottoContainer"></div>
                    </div>
                </div>
            </div>

            <!-- Entry/Exit Signals -->
            <div class="panel" id="signalsPanel" style="display: none;">
                <div class="panel-header">
                    <div class="panel-title">Entry / Exit Signals</div>
                    <span id="signalsCount" style="font-size: 12px; color: #8b949e;"></span>
                </div>
                <div class="panel-body" id="signalsContainer"></div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            Greeks Analytics Dashboard v2.0 | Using Dhan Pre-Calculated Greeks
        </div>
    </div>

    <script>
        const API_BASE = 'http://localhost:5000/api';
        let updateInterval;

        async function fetchGreeksData() {
            try {
                const response = await fetch(`${API_BASE}/greeks-pro`);
                const data = await response.json();

                if (data.status === 'ok') {
                    updateDashboard(data);
                } else {
                    showError(data.message || 'Failed to fetch Greeks data');
                }
            } catch (error) {
                console.error('Error fetching Greeks data:', error);
                showError('Connection error. Please ensure main.py and api.py are running.');
            }
        }

        function updateDashboard(data) {
            // Update metrics
            document.getElementById('spotPrice').textContent = data.spot.toFixed(2);
            document.getElementById('vixValue').textContent = data.vix.toFixed(2);
            document.getElementById('netDeltaFlow').textContent = data.trend_intensity.net_delta_flow.toFixed(3);
            document.getElementById('ivRank').textContent = `${data.iv_rank.toFixed(0)}%`;
            document.getElementById('dteValue').textContent = data.dte;
            document.getElementById('pcrValue').textContent = data.pcr_divergence.pcr.toFixed(2);

            // VIX Change
            const vixChange = document.getElementById('vixChange');
            vixChange.textContent = `${data.vix_change_pct >= 0 ? '+' : ''}${data.vix_change_pct.toFixed(2)}%`;
            vixChange.className = `metric-change ${data.vix_change_pct >= 0 ? 'positive' : 'negative'}`;

            // Market Bias
            const bias = data.trend_intensity.market_bias;
            const biasEl = document.getElementById('marketBias');
            biasEl.textContent = bias;
            biasEl.className = `metric-change ${bias === 'BULLISH' ? 'positive' : bias === 'BEARISH' ? 'negative' : 'neutral'}`;

            // Update timestamps
            const now = new Date(data.timestamp);
            document.getElementById('lastUpdate').textContent = `Last Update: ${now.toLocaleTimeString()}`;
            document.getElementById('expiryInfo').textContent = `Expiry: ${data.dte} days`;

            // Alert Banner
            if (data.pcr_divergence.divergence) {
                document.getElementById('alertBanner').style.display = 'block';
                document.getElementById('alertBannerText').textContent = `⚠️ ${data.pcr_divergence.signal}`;
            }

            // Update main table (mix top CE and PE)
            const allStrikes = [...data.ce_top5, ...data.pe_top5]
                .sort((a, b) => (b.efficiency || 0) - (a.efficiency || 0))
                .slice(0, 10);
            updateMainTable(allStrikes);

            // Update alerts
            if (data.alerts && data.alerts.length > 0) {
                document.getElementById('alertsPanel').style.display = 'block';
                updateAlerts(data.alerts);
            }

            // Update signals
            if (data.entry_signals && data.entry_signals.length > 0) {
                document.getElementById('signalsPanel').style.display = 'block';
                updateSignals(data.entry_signals);
            }

            // Update lotto strikes
            if (data.lotto_strikes && data.lotto_strikes.length > 0) {
                document.getElementById('lottoPanel').style.display = 'block';
                updateLottoStrikes(data.lotto_strikes);
            }
        }

        function updateMainTable(strikes) {
            const tbody = document.getElementById('greeksTableBody');
            tbody.innerHTML = strikes.map(strike => `
                <tr>
                    <td style="font-weight: 600; color: #fff;">${strike.strike_price}</td>
                    <td><span class="badge" style="background: ${strike.option_type === 'CE' ? '#238636' : '#da3633'}; color: #fff;">${strike.option_type}</span></td>
                    <td><span class="badge badge-${strike.rank.toLowerCase().replace('_', '-')}">${strike.rank}</span></td>
                    <td>₹${strike.ltp.toFixed(2)}</td>
                    <td style="font-weight: 600; color: ${strike.efficiency > 2.5 ? '#3fb950' : '#8b949e'};">${strike.efficiency?.toFixed(2) || 'N/A'}</td>
                    <td style="color: ${strike.delta >= 0 ? '#3fb950' : '#f85149'};">${strike.delta.toFixed(3)}</td>
                    <td style="color: #f85149;">${strike.theta.toFixed(3)}</td>
                    <td style="color: #d29922;">${strike.gamma.toFixed(4)}</td>
                    <td>${(strike.iv * 100).toFixed(1)}%</td>
                    <td>
                        ${strike.theta_trap ? '<span style="color: #f85149;">🔴 Theta Trap</span>' : ''}
                        ${strike.gamma_blast ? '<span style="color: #8250df;">⚡ Gamma</span>' : ''}
                    </td>
                </tr>
            `).join('');
        }

        function updateAlerts(alerts) {
            const container = document.getElementById('alertsContainer');
            container.innerHTML = alerts.map(alert => `
                <div class="alert-item">
                    <div class="alert-type">${alert.type}</div>
                    <div>${alert.strike}: ${alert.message}</div>
                    <div style="font-size: 11px; color: #6e7681; margin-top: 4px;">${alert.time}</div>
                </div>
            `).join('');
        }

        function updateSignals(signals) {
            const container = document.getElementById('signalsContainer');
            document.getElementById('signalsCount').textContent = `${signals.length} signals`;
            container.innerHTML = signals.map(sig => `
                <div class="alert-item">
                    <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 6px;">
                        <span class="signal-badge signal-${sig.signal.toLowerCase().replace(' ', '-')}">${sig.signal}</span>
                        <span style="font-size: 11px; color: #6e7681;">${sig.time}</span>
                    </div>
                    <div style="font-weight: 600; margin-bottom: 4px;">${sig.instrument} <span class="badge badge-${sig.rank.toLowerCase()}">${sig.rank}</span></div>
                    <div style="font-size: 12px; color: #8b949e;">${sig.reasoning}</div>
                    <div style="font-size: 11px; color: #6e7681; margin-top: 6px;">
                        Efficiency: ${sig.eff_score?.toFixed(2) || 'N/A'} | Confidence: ${sig.confidence}%
                    </div>
                </div>
            `).join('');
        }

        function updateLottoStrikes(strikes) {
            const container = document.getElementById('lottoContainer');
            container.innerHTML = strikes.map(strike => `
                <div class="alert-item">
                    <div style="display: flex; justify-content: space-between;">
                        <div>
                            <span style="font-weight: 600; color: #fff;">${strike.strike_price}</span>
                            <span class="badge" style="background: ${strike.option_type === 'CE' ? '#238636' : '#da3633'}; color: #fff; margin-left: 8px;">${strike.option_type}</span>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-size: 16px; font-weight: 600; color: #8250df;">₹${strike.ltp.toFixed(2)}</div>
                        </div>
                    </div>
                    <div style="font-size: 12px; color: #8b949e; margin-top: 6px;">
                        Gamma: ${strike.gamma.toFixed(4)} | Efficiency: ${strike.efficiency?.toFixed(2) || 'N/A'}
                    </div>
                </div>
            `).join('');
        }

        function showError(message) {
            document.querySelector('.content-area').innerHTML = `
                <div class="error">
                    <h2>⚠️ Error</h2>
                    <p>${message}</p>
                    <p style="margin-top: 12px; font-size: 14px;">Make sure main.py and api.py are running</p>
                </div>
            `;
        }

        // Initialize
        fetchGreeksData();
        updateInterval = setInterval(fetchGreeksData, 60000); // Update every 60 seconds
    </script>
</body>
</html>
